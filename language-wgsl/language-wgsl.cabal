cabal-version:      3.4
name:               language-wgsl
version:            0.1.0.0
synopsis:           AST, prettyprinter, and other tools for the WebGPU Shading Language.

description:        A package for working with the
                    <https://www.w3.org/TR/WGSL/ WebGPU Shading Language>
                    (WGSL).
                    .
                    The package is currently fairly minimalistic, and mostly
                    useful for programs that want to generate WGSL.

license:            ISC
license-file:       LICENSE
author:             Sebastian Paarmann
maintainer:         Troels Henriksen <athas@sigkill.dk>
copyright:          Sebastian Paarmann and the University of Copenhagen
category:           Language
homepage:           https://github.com/diku-dk/language-wgsl
bug-reports:        https://github.com/diku-dk/language-wgsl/issues
build-type:         Simple
tested-with:        GHC == 9.12.3
extra-doc-files:    CHANGELOG.md
                    README.md

source-repository head
    type:     git
    location: https://github.com/diku-dk/language-wgsl.git

common warnings
    ghc-options: -Wall -Wcompat

library
    import:           warnings
    exposed-modules:  Language.WGSL
    build-depends:    base >=4.15 && <5,
                      text,
                      prettyprinter >= 1.7
    hs-source-dirs:   src
    default-language: GHC2021
    default-extensions:
      OverloadedStrings

test-suite language-wgsl-test
    import:           warnings
    default-language: GHC2021
    default-extensions:
      OverloadedStrings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Main.hs
    build-depends:
        base >=4.15 && <5,
        language-wgsl
