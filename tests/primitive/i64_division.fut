-- Test of division-like operators for i64 values.  Dividing the
-- most negative value by -1 wraps around.

-- ==
-- entry: divide
-- input { [7i64, -7i64, 7i64, -7i64, -9223372036854775808i64, -9223372036854775808i64, 9223372036854775807i64]
--         [3i64, 3i64, -3i64, -3i64, -1i64, 1i64, -1i64] }
-- output { [2i64, -3i64, -3i64, 2i64, -9223372036854775808i64, -9223372036854775808i64, -9223372036854775807i64] }

-- ==
-- entry: mod
-- input { [7i64, -7i64, 7i64, -7i64, -9223372036854775808i64, -9223372036854775808i64, 9223372036854775807i64]
--         [3i64, 3i64, -3i64, -3i64, -1i64, 1i64, -1i64] }
-- output { [1i64, 2i64, -2i64, -1i64, 0i64, 0i64, 0i64] }

-- ==
-- entry: quot
-- input { [7i64, -7i64, 7i64, -7i64, -9223372036854775808i64, -9223372036854775808i64, 9223372036854775807i64]
--         [3i64, 3i64, -3i64, -3i64, -1i64, 1i64, -1i64] }
-- output { [2i64, -2i64, -2i64, 2i64, -9223372036854775808i64, -9223372036854775808i64, -9223372036854775807i64] }

-- ==
-- entry: rem
-- input { [7i64, -7i64, 7i64, -7i64, -9223372036854775808i64, -9223372036854775808i64, 9223372036854775807i64]
--         [3i64, 3i64, -3i64, -3i64, -1i64, 1i64, -1i64] }
-- output { [1i64, -1i64, 1i64, -1i64, 0i64, 0i64, 0i64] }

entry divide = map2 (i64./)
entry mod = map2 (i64.%)
entry quot = map2 (i64.//)
entry rem = map2 (i64.%%)
