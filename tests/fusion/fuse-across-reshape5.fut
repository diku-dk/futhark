-- ==
-- input { [1,2,3] [4,5,6] }
-- output { [2.8284271247461903f32, 3.1622776601683795f32, 3.4641016151377544f32, 3.4641016151377544f32, 3.872983346207417f32, 4.242640687119285f32, 4.0f32, 4.47213595499958f32, 4.898979485566356f32] }
-- structure { Screma 1 }

entry main A B =
  map (\a -> map (\b -> (a + 1) * b) B) A
  |> flatten
  |> map (f32.sqrt <-< f32.i32)
