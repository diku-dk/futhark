-- https://rosettacode.org/wiki/Euler_method#Common_Lisp
--
-- Specialised to the cooling function.  We produce an array of the
-- temperature at each step subtracted from the analytically
-- determined temperature (so we are computing the error).
--
-- ==
-- input { 100.0f32 0.0f32 100.0f32 2.0f32 }
-- output {
--   [0.0f32, 0.7486588319044785f32, 1.2946993164580505f32, 1.679265585204547f32,
--    1.9360723079051994f32, 2.0926628953127633f32, 2.1714630634463745f32,
--    2.1906621307551717f32, 2.1649494013163135f32, 2.106128735048543f32,
--    2.0236308042860642f32, 1.924939486661728f32, 1.8159462635058006f32,
--    1.7012443098140402f32, 1.5843721158726787f32, 1.4680149205211634f32,
--    1.354170918183268f32, 1.2442880891724784f32, 1.139376563939308f32,
--    1.0401006401924064f32, 0.9468539045506148f32, 0.859820348366565f32,
--    0.7790238943202752f32, 0.7043683525135087f32, 0.6356694904077109f32,
--    0.572680620138101f32, 0.5151128711182906f32, 0.46265111832983763f32,
--    0.4149663712668854f32, 0.37172529010454625f32, 0.3325973799923041f32,
--    0.29726031781953566f32, 0.2654037853016753f32, 0.23673211521330373f32,
--    0.21096600187360082f32, 0.1878434807373779f32, 0.16712034361770378f32,
--    0.14857012436523576f32, 0.13198376366226583f32, 0.11716904003828077f32,
--    0.10394983650827427f32, 9.216529772764304e-2f32, 8.166892070760667e-2f32,
--    7.232761248797459e-2f32, 6.402074034058458e-2f32, 5.663919376000237e-2f32,
--    5.008447242299141e-2f32, 4.426781024452353e-2f32, 3.9109342442220196e-2f32,
--    3.453731999022125e-2f32]
--
-- }
--
-- input { 100.0f32 0.0f32 100.0f32 5.0f32 }
-- output {
-- [0.0f32, 4.375047177497066f32, 5.926824303312763f32, 6.025019928892426f32,
-- 5.447257115328519f32, 4.619590476035608f32, 3.763003010238556f32,
-- 2.9817046074496396f32, 2.315646506892435f32, 1.7712171223319615f32,
-- 1.338771206215167f32, 1.0023162611494705f32, 0.7446054205897603f32,
-- 0.5495998794267152f32, 0.4034719393409745f32, 0.2948359128180762f32,
-- 0.21460148389295242f32, 0.15566929274598706f32, 0.11258571548996343f32,
-- 8.121463510024185e-2f32]
-- }
--
-- input { 100.0f32 0.0f32 100.0f32 10.0f32 }
-- output {
-- [0.0f32, 15.726824303312767f32, 12.52775711532852f32, 7.636514260238556f32,
-- 4.216805010017435f32, 2.221390673785482f32, 1.1413261456382173f32,
-- 0.5782306456739441f32, 0.290580297318634f32, 0.14532974216231054f32]
-- }

def analytic (t0: f32) (time: f32) : f32 =
  20.0 + (t0 - 20.0) * f32.exp (-0.07 * time)

def cooling (_time: f32) (temperature: f32) : f32 =
  -0.07 * (temperature - 20.0)

def main (t0: f32) (a: f32) (b: f32) (h: f32) : []f32 =
  let steps = i64.f32 ((b - a) / h)
  let temps = replicate steps 0.0
  let (_, temps) =
    loop (t, temps) = (t0, temps)
    for i < steps do
      let x = a + f32.i64 i * h
      let temps[i] = f32.abs (t - analytic t0 x)
      in ( t + h * cooling x t
         , temps
         )
  in temps
